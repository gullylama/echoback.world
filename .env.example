# EchoBack environment
# With NOTHING set, the app runs in demo mode: in-memory store, seeded
# library, simulated billing — the full loop with zero configuration.

# ---- Site -----------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://echoback.world

# ---- Supabase (auth, Postgres + pgvector, storage) -------------------------
# Setting the two NEXT_PUBLIC_ vars switches the app out of demo mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Stripe (four monthly tiers) -------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CREATOR_ARTISTS=   # £15.99/mo
STRIPE_PRICE_CREATOR_FULL=      # £20/mo
STRIPE_PRICE_ARTIST=            # £15.99/mo
STRIPE_PRICE_PRODUCER=          # £15.99/mo

# ---- Fingerprint worker (worker/fingerprint.py on GPU host) ----------------
FINGERPRINT_WORKER_SECRET=

# ---- Email (Resend) --------------------------------------------------------
RESEND_API_KEY=
