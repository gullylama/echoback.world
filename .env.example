# EchoBack environment
# With NOTHING set, the app runs in demo mode: in-memory store, seeded
# library, simulated billing — the full loop with zero configuration.

# ---- Site -----------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://echoback.world

# ---- Supabase (auth, Postgres + pgvector, storage) -------------------------
# Setting the two NEXT_PUBLIC_ vars switches the app out of demo mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Stripe (four monthly tiers) -------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CREATOR_ARTISTS=   # £16/mo
STRIPE_PRICE_CREATOR_FULL=      # £20/mo
STRIPE_PRICE_ARTIST=            # £16/mo
STRIPE_PRICE_PRODUCER=          # £16/mo

# ---- Fingerprint worker (worker/fingerprint.py on GPU host) ----------------
# Shared secret between the app and the worker. Invent a long random string.
FINGERPRINT_WORKER_SECRET=

# Operator tool: set to 1 to enable POST /api/fingerprint/seed, which fills
# pending uploads with PLACEHOLDER vectors so the live pipeline can be tested
# before the GPU worker exists. Similarities it produces are NOT real match
# quality. Leave unset in normal operation and REMOVE it once the real worker
# is running. Requires FINGERPRINT_WORKER_SECRET as well.
SEED_FINGERPRINTS=

# ---- Email (Resend) --------------------------------------------------------
RESEND_API_KEY=
